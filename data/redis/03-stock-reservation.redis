LMOVE shop:stock:ready shop:stock:processing LEFT RIGHT
EVAL "local n=#KEYS-1 if redis.call('SADD',KEYS[1],ARGV[1])==0 then return -1 end for i=1,n do local a=tonumber(redis.call('HGET',KEYS[i+1],'available')) if (not a) or a<tonumber(ARGV[i+2]) then return 0 end end for i=1,n do redis.call('HINCRBY',KEYS[i+1],'available',-tonumber(ARGV[i+2])) redis.call('HINCRBY',KEYS[i+1],'reserved',tonumber(ARGV[i+2])) redis.call('HSET',KEYS[i+1],'updatedAt',ARGV[2]) end return 1" 3 shop:stock:processed stock:PROD-1 stock:PROD-2 evt-0001 2026-10-29T10:00:02Z 2 1
RPUSH shop:events:published '{"eventId":"evt-0005","eventType":"StockReserved","eventVersion":1,"occurredAt":"2026-10-29T10:00:02Z","emitter":"Stock","aggregateId":"CMD-1","payload":{"orderId":"CMD-1","reservedLines":[{"productId":"PROD-1","quantity":2},{"productId":"PROD-2","quantity":1}]}}'
